    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Removes the relationship of the deleted Contact Account Relationship from the corresponding Account Contact Relationship Roles picklist</description>
    <environments>Default</environments>
    <formulas>
        <name>f_updatedRoles</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
     SUBSTITUTE(
          {!v_Roles},
          TEXT({!$Record.EDUtb_Contact_s_Relationship_to_Account__c})+&apos;;&apos;,
          &apos;&apos;
     ),
     &apos;;&apos;+TEXT({!$Record.EDUtb_Contact_s_Relationship_to_Account__c}),
     &apos;&apos;
)</expression>
    </formulas>
    <interviewLabel>Contact Account Relationship - On Delete {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Contact Account Relationship - On Delete</label>
    <processMetadataValues>
        <name>BuilderType</name>
