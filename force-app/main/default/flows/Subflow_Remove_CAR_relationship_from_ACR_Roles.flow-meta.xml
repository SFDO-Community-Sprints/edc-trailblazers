    <description>Removes the &quot;Contact&apos;s Relationship to Account&quot; value on the Contact_Account_Relation__c record from the corresponding AccountContactRelation record. Used in both the CAR After Save &amp; Before Delete flows</description>
    <environments>Default</environments>
    <formulas>
        <name>f_UpdatedRoles</name>
        <dataType>String</dataType>
        <expression>SUBSTITUTE(
     SUBSTITUTE(
          {!v_Roles},
          TEXT({!r_inputCAR.EDUtb_Contact_s_Relationship_to_Account__c})+&apos;;&apos;,
          &apos;&apos;
     ),
     &apos;;&apos;+TEXT({!r_inputCAR.EDUtb_Contact_s_Relationship_to_Account__c}),
     &apos;&apos;
)</expression>
    </formulas>
